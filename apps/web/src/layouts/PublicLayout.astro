---
import '@tap4furry/design/global.scss';
import '../styles/layout.css';
import '../styles/resource.scss';
import { PUBLIC_READ_CACHE } from '../lib/public-api.server';
interface Props { title: string; description: string; canonical: string; locale: string; status: number }
const { title, description, canonical, locale, status } = Astro.props;
Astro.response.status = status;
Astro.response.headers.set('Cache-Control', status === 200 ? PUBLIC_READ_CACHE : 'no-store');
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · Tap4Furry</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · Tap4Furry`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="robots" content={status === 200 ? 'index, follow' : 'noindex, nofollow'} />
  </head>
  <body>
    <header class="mx-auto flex max-w-5xl items-center justify-between gap-6 px-6 py-6">
      <a class="resource-brand" href="/">Tap4Furry</a>
      <nav aria-label="Main navigation" class="flex flex-wrap gap-6"><a href="/resources">Resources</a><a href="/submit">Suggest a Resource</a><a href="/account">Account</a></nav>
    </header>
    <main class="mx-auto flex max-w-5xl flex-col gap-8 px-6 pb-16"><slot /></main>
    <footer class="mx-auto max-w-5xl px-6 pb-8 resource-muted">Knowledge for the furry community.</footer>
  </body>
</html>
