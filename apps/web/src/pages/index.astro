---
import '@tap4furry/design/global.scss';
import '../styles/layout.css';
import '../styles/page.scss';
import HealthCheck from '../components/HealthCheck';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Tap4Furry engineering foundation." />
    <title>Tap4Furry</title>
  </head>
  <body>
    <main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center gap-6 p-6">
      <section class="foundation flex flex-col gap-6 p-6 sm:p-10" aria-labelledby="title">
        <span class="phase">Welcome to Tap4Furry</span>
        <h1 id="title">Tap4Furry</h1>
        <p>A place for discovering and exchanging furry resources. Create your account and choose how you appear.</p>
        <nav aria-label="Account" class="flex flex-wrap gap-6"><a href="/register">Create account</a><a href="/login">Log in</a><a href="/account">Your account</a></nav>
        <HealthCheck client:load />
      </section>
    </main>
  </body>
</html>
