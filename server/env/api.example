APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:4321
# Development/test may omit CSRF_SECRET. Production requires a private >=32-byte value.
# AUTH_THROTTLE_SECRET follows the same rule; use the same value in API and Admin.
MAIL_MODE=local
MAIL_LOCAL_DIR=../.local/mail
DATABASE_URL=postgres://gfp_api:replace-me@127.0.0.1:5432/gfp_dev?sslmode=disable
REDIS_URL=redis://gfp_runtime:replace-me@127.0.0.1:6379/0
REDIS_KEY_PREFIX=gfp:

# Each optional provider pair must be both present or both absent.
# Replace these public placeholders only in your private launch configuration.
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...
GITHUB_OAUTH_CLIENT_ID=...
GITHUB_OAUTH_CLIENT_SECRET=...
